{
  "name": "hugframe",
  "version": "3.0.0",
  "description": "An iframe that sizes itself to its content and morphs into a chromeless full-window view. Dependency-free TypeScript, cross-domain over postMessage.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiriana/hugframe.git",
    "directory": "packages/hugframe"
  },
  "bugs": {
    "url": "https://github.com/tiriana/hugframe/issues"
  },
  "homepage": "https://tiriana.github.io/hugframe/",
  "keywords": [
    "iframe",
    "auto-height",
    "iframe-resize",
    "resize",
    "responsive",
    "embed",
    "postmessage",
    "cross-domain",
    "custom-element",
    "web-component",
    "fullscreen",
    "micro-frontend",
    "typescript",
    "zero-dependencies"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./child": {
      "types": "./dist/child.d.ts",
      "default": "./dist/child.js"
    },
    "./css": "./dist/hugframe.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:types && npm run build:css",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.json",
    "build:css": "node scripts/copy-css.mjs",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.*\""
  },
  "devDependencies": {
    "lightningcss": "^1.33.0",
    "vite": "^8.3.4"
  }
}
