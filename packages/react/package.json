{
  "name": "@hugframe/react",
  "version": "0.1.1",
  "description": "React bindings for hugframe: an iframe that hugs its content, then morphs into a chromeless full-window view.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiriana/hugframe.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/tiriana/hugframe/issues"
  },
  "homepage": "https://tiriana.github.io/hugframe/",
  "keywords": [
    "iframe",
    "auto-height",
    "react",
    "embed",
    "postmessage",
    "hugframe"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:deps && npm run build:js && npm run build:types",
    "build:deps": "npm run build -w hugframe",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.*\""
  },
  "dependencies": {
    "hugframe": "^2.0.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  }
}
