{
  "name": "hugframe-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "hugframe and its framework wrappers.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiriana/hugframe.git"
  },
  "workspaces": [
    "packages/hugframe",
    "packages/react",
    "apps/site"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:pages": "npm run build:pages -w apps/site",
    "dev": "npm run dev -w apps/site",
    "test": "node --test \"scripts/*.test.mjs\" && npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w apps/site",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.19.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2"
  }
}
