{
  "name": "hugframe",
  "version": "0.0.0",
  "description": "An iframe that sizes itself to its content and morphs into a chromeless full-window view. Dependency-free TypeScript, cross-domain over postMessage.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiriana/hugframe.git"
  },
  "bugs": {
    "url": "https://github.com/tiriana/hugframe/issues"
  },
  "homepage": "https://tiriana.github.io/hugframe/",
  "keywords": [
    "iframe",
    "auto-height",
    "iframe-resize",
    "resize",
    "responsive",
    "embed",
    "postmessage",
    "cross-domain",
    "custom-element",
    "web-component",
    "fullscreen",
    "micro-frontend",
    "typescript",
    "zero-dependencies"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./child": {
      "types": "./dist/child.d.ts",
      "default": "./dist/child.js"
    },
    "./css": "./dist/hugframe.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:js && npm run build:types && npm run build:css",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "vite build --config vite.lib.config.ts",
    "build:css": "node scripts/copy-css.mjs",
    "build:demo": "vite build --outDir .demo-dist",
    "build:demo:pages": "vite build --outDir .demo-dist --base=/hugframe/",
    "build:docs": "node scripts/build-docs.mjs",
    "build:pages": "npm run build:demo:pages && npm run build:docs && node scripts/assemble-pages.mjs",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.*\"",
    "release": "semantic-release",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.19.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.6.0",
    "marked": "^15.0.12",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
