{
  "name": "@hugframe/site",
  "version": "0.0.0",
  "private": true,
  "description": "The hugframe demo, playground and API reference.",
  "type": "module",
  "scripts": {
    "build:deps": "npm run build -w hugframe",
    "dev": "npm run build:deps && vite",
    "build": "npm run build:deps && vite build --outDir .demo-dist",
    "build:demo:pages": "npm run build:deps && vite build --outDir .demo-dist --base=${GF_BASE_PATH:-/hugframe/}",
    "build:docs": "node scripts/build-docs.mjs",
    "build:pages": "npm run build:demo:pages && npm run build:docs && node scripts/assemble-pages.mjs",
    "test:e2e": "node test/e2e/run.mjs"
  },
  "dependencies": {
    "hugframe": "*"
  },
  "devDependencies": {
    "marked": "^15.0.12",
    "playwright": "^1.64.1",
    "vite": "^8.3.4"
  }
}
